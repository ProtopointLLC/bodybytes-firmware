[global]
filename=/mnt/data/fio-test
direct=1
ioengine=libaio
group_reporting

[seq-write]
rw=write
bs=1M
iodepth=1
size=128M

[seq-read]
stonewall
rw=read
bs=1M
iodepth=1
size=128M

[rand-write-4k]
stonewall
rw=randwrite
bs=4k
iodepth=8
size=128M

[rand-read-4k]
stonewall
rw=randread
bs=4k
iodepth=8
size=128M