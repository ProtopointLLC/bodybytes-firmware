{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "U-Boot: Build",
            "type": "shell",
            "command": "nix develop .#uboot --command bash -c 'cd u-boot && make bodybytes_defconfig && make -j$(nproc)'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}/u-boot"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "U-Boot: Clean",
            "type": "shell",
            "command": "nix develop .#uboot --command bash -c 'cd u-boot && make mrproper'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "OpenWrt: Setup",
            "type": "shell",
            "command": "nix run .#openwrt -- -c 'cd openwrt && ./scripts/feeds update -a && for f in packages luci routing telephony video; do ./scripts/feeds install -a -p $f; done && ./scripts/feeds install -p immortalwrt_luci luci-app-dufs && cp ../bodybytes.config .config && make defconfig && make download'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "OpenWrt: Download Packages",
            "type": "shell",
            "command": "nix run .#openwrt -- -c 'cd openwrt && cp ../bodybytes.config .config && make defconfig && make download'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "OpenWrt: Build",
            "type": "shell",
            "command": "nix run .#openwrt -- -c 'cd openwrt && cp ../bodybytes.config .config && make defconfig && make V=s world -j$(nproc)'",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}/openwrt"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Serial Monitor",
            "type": "shell",
            "command": "nix develop .#uboot --command picocom -b 921600 --flow n /dev/ttyUSB0",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "JTAG: Start OpenOCD J-Link",
            "type": "shell",
            "command": "nix develop .#uboot --command python3 scripts/start_openocd_jlink.py --${input:board}",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": ".*OpenOCD: failed|ready.*",
                    "beginsPattern": ".*Open On-Chip Debugger.*"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Flash: NOR (all partitions)",
            "detail": "Erases and writes every partition. Requires --mac for the factory blob.",
            "type": "shell",
            "command": "nix develop .#uboot --command python3 scripts/flash_nor_images.py --${input:transport} --all --${input:board} --mac ${input:mac}",
            "dependsOn": "JTAG: Start OpenOCD J-Link",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Flash: U-Boot + env",
            "detail": "Writes u-boot-with-spl.bin and the U-Boot environment only.",
            "type": "shell",
            "command": "nix develop .#uboot --command python3 scripts/flash_nor_images.py --${input:transport} --u-boot --u-boot-env --${input:board} --mac ${input:mac}",
            "dependsOn": "JTAG: Start OpenOCD J-Link",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Flash: Erase NOR (full chip)",
            "detail": "Erases the entire SPI NOR. Destructive - the board will not boot until reflashed.",
            "type": "shell",
            "command": "nix develop .#uboot --command python3 scripts/flash_nor_images.py --${input:transport} --${input:board} --full-erase",
            "dependsOn": "JTAG: Start OpenOCD J-Link",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "JTAG: Boot U-Boot from RAM",
            "type": "shell",
            "command": "nix develop .#uboot --command python3 scripts/boot_uboot_jtag.py --${input:board}",
            "dependsOn": "JTAG: Start OpenOCD J-Link",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "board",
            "type": "pickString",
            "description": "Select board",
            "options": ["vocore2", "bodybytes"],
            "default": "vocore2"
        },
        {
            "id": "transport",
            "type": "pickString",
            "description": "Flash transport",
            "options": [
                {
                    "label": "jtag - stage into RAM over JTAG (needs OpenOCD + J-Link)",
                    "value": "jtag"
                },
                {
                    "label": "ymodem - stage over the serial console (needs only a U-Boot prompt)",
                    "value": "ymodem"
                }
            ],
            "default": "jtag"
        },
        {
            "id": "mac",
            "type": "promptString",
            "description": "WiFi MAC address (XX:XX:XX:XX:XX:XX)",
            "default": "AA:BB:CC:DD:EE:01"
        }
    ]
}